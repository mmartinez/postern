              <p class="text-xs text-zinc-500 mt-0.5">Linux amd64 / arm64</p>
            </div>
            <div class="p-5 font-mono text-sm space-y-3">
              <div>
                <p class="text-zinc-500 text-xs mb-1.5">Install script (verifies SHA-256):</p>
                <p><span class="text-emerald-400 select-none">$ </span><span class="text-zinc-300">curl -fsSL https://raw.githubusercontent.com/mmartinez/postern/main/install.sh | sh</span></p>
              </div>
              <div class="pt-3 border-t border-border">
                <p class="text-zinc-500 text-xs mb-1.5">Verify the cosign signature before trusting:</p>
                <p class="text-zinc-300 whitespace-pre-wrap break-all text-xs">cosign verify-blob \
  --bundle checksums.txt.sigstore.json \
  --certificate-identity-regexp '...' \
  checksums.txt</p>
              </div>
            </div>
          </div>

          <!-- Docker -->
          <div class="rounded-lg border border-border bg-surface overflow-hidden">
            <div class="px-5 py-4 border-b border-border bg-surface-raised">
              <h3 class="text-sm font-semibold text-zinc-200">Docker</h3>
