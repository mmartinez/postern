              </div>
              <div class="pt-3 border-t border-border">
                <p class="text-zinc-500 text-xs mb-1.5">Bootstrap + run with Docker Compose:</p>
                <div class="space-y-1">
                  <p><span class="text-emerald-400 select-none">$ </span><span class="text-zinc-300">docker compose run --rm bootstrap</span></p>
                  <p><span class="text-emerald-400 select-none">$ </span><span class="text-zinc-300">docker compose up -d</span></p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Build from source -->
        <div class="mt-6 rounded-lg border border-border bg-surface overflow-hidden">
          <div class="px-5 py-4 border-b border-border bg-surface-raised">
            <h3 class="text-sm font-semibold text-zinc-200">Build from source</h3>
