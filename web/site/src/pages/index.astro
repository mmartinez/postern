    <!-- SECURITY -->
    <section class="py-20 px-6 border-t border-border">
      <div class="mx-auto max-w-4xl">
        <div class="grid sm:grid-cols-2 gap-10 items-center">
          <div>
            <h2 class="text-2xl sm:text-3xl font-bold text-zinc-50 mb-4">Security model</h2>
            <p class="text-zinc-400 leading-relaxed mb-6">
              The real credential exists only inside the postern process and on the wire to the upstream. It never crosses to the agent's side.
            </p>
            <ul class="space-y-3">
              <li class="flex gap-3 text-sm">
                <svg class="flex-shrink-0 mt-0.5 text-emerald-400" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8l4 4 6-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="text-zinc-300">Agent holds no credential — only the placeholder it sent (if any)</span>
              </li>
              <li class="flex gap-3 text-sm">
                <svg class="flex-shrink-0 mt-0.5 text-emerald-400" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8l4 4 6-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="text-zinc-300"><code class="text-zinc-400 bg-zinc-800 px-1 rounded text-xs">postern rules list</code> shows the <code class="text-zinc-400 bg-zinc-800 px-1 rounded text-xs">secret_ref</code>, never a resolved value</span>
              </li>
              <li class="flex gap-3 text-sm">
                <svg class="flex-shrink-0 mt-0.5 text-emerald-400" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8l4 4 6-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="text-zinc-300">Logs redact credential-bearing headers and never print a resolved secret</span>
              </li>
              <li class="flex gap-3 text-sm">
                <svg class="flex-shrink-0 mt-0.5 text-emerald-400" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8l4 4 6-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="text-zinc-300">Only brokered hosts have TLS intercepted — unmatched hosts are tunneled untouched</span>
              </li>
              <li class="flex gap-3 text-sm">
                <svg class="flex-shrink-0 mt-0.5 text-emerald-400" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8l4 4 6-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="text-zinc-300">Resolver errors fail closed with 502 — upstream is never reached on failure</span>
              </li>
            </ul>
          </div>
