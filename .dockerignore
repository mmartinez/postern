# Don't ship build output or local junk into the image build context.
dist/
coverage.out
coverage.html
*.test

# Planning artifacts never enter the image.
PRD-*.md
SPEC.md
tasks/
docs/proposals.md
postern-roadmap.html

# Local contributor instructions and settings are not build inputs.
AGENTS.md
CLAUDE.md
.omp/
.claude/*
!.claude/skills/
!.claude/skills/**
.agents/*
!.agents/skills/
!.agents/skills/**

# Editor / OS noise
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Web frontends are not part of the backend image build.
web/

# Local env / secrets — never in image context
.env
.env.*

# Repository metadata and local Git configuration are not build inputs.
.git
